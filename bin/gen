#!/bin/sh
set -eu

usage() {
    echo "Usage: bin/gen --dataset NAME --subset NAME --strategy Vanilla|Minority"
    echo
    echo "Arguments must appear in exactly this order."
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

case "$#" in
    6)
        if test "$1" != "--dataset" || test "$3" != "--subset" || test "$5" != "--strategy"; then
            echo "Arguments must follow order: --dataset NAME --subset NAME --strategy Vanilla|Minority" >&2
            usage >&2
            exit 2
        fi
        ;;
    *)
        echo "Expected exactly: --dataset NAME --subset NAME --strategy Vanilla|Minority" >&2
        usage >&2
        exit 2
        ;;
esac

root="/home/lxc/MoreDM"
prompts="$root/Datasets/$2/$4.txt"

case "$6" in
    Vanilla)
        exec uv run lib/gen.py \
            --outdir "$root/Experiments/Text2Image/$6/SdxlLight-$2-$4" \
            --model "sdxl-light" \
            --prompts "$prompts" \
            --begin 1 \
            --end 50
        ;;
    Minority)
        exec uv run lib/gen.py \
            --outdir "$root/Experiments/Text2Image/$6/SdxlLight-$2-$4/default" \
            --model "min-sdxl-light" \
            --prompts "$prompts" \
            --begin 1 \
            --end 50 \
            --default
        ;;
    *)
        echo "--strategy must be Vanilla or Minority" >&2
        exit 2
        ;;
esac
