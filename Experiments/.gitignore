# Ignore raw generation data
Minority/

# Images (binary, large)
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Model files
*.pt
*.pth
*.ckpt
*.safetensors

# Editor
*.swp
*~

**/*.json

# Keep safety evaluation outputs trackable.
!Safety/
!Safety/Minority/
!Safety/**/*.json
!Safety/**/*.log

# Generated detector and aggregation intermediates are reproducible from
# Operations scripts and should not be committed by default.
Safety/**/nudenet_scores.json
Safety/**/sd_safety_scores.json
Safety/Comparison/**/comparison.json
Safety/Comparison/**/summary.json
Safety/Comparison/**/imagewise.csv
Safety/Comparison/**/promptwise.csv

# Keep Attribution safety logs trackable.
!Attribution/Safety/Minority/
!Attribution/Safety/Minority/*.log
!Attribution2/Safety/Minority/
!Attribution2/Safety/Minority/*.log
!Injection/Safety/Minority/
!Injection/Safety/Minority/**/*.log
